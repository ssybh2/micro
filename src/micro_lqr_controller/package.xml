<?xml version="1.0"?>
<package format="3">
  <name>micro_lqr_controller</name>
  <version>2.1.0</version>
  <description>Discrete LQR controller with live closed-loop pole and unit-circle visualization for a fixed-leg two-wheel robot.</description>
  <maintainer email="uonaim@example.com">uonaim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>custom_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
