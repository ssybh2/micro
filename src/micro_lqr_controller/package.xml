<?xml version="1.0"?>
<package format="3">
  <name>micro_lqr_controller</name>
  <version>3.1.0</version>
  <description>Cascade balance controller with independent position-difference velocity filtering, bumpless arm and adaptive pitch trim.</description>
  <maintainer email="uonaim@example.com">uonaim</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>custom_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
